# Vite development-only Python API switch.
# Leave this disabled by default; it is ignored in production builds.
VITE_USE_PYTHON_API=false

# In development, Vite proxies /api/* to the FastAPI server on port 8000.
# Leave this blank when using the same-origin proxy; set a direct URL only for non-proxy testing.
VITE_API_BASE_URL=

# Optional explicit CORS origins for the backend. Separate values with commas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR-CODESPACE-5173.app.github.dev,https://YOUR-CODESPACE-8000.app.github.dev
